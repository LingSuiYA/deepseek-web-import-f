{
  "name": "deepseek-web-import",
  "version": "0.2.0-dlc.11",
  "description": "Import chat.deepseek.com conversations into DeepSeek Harness as resumable sessions. Feature supplement for upstream 0.2.0: imports images and documents, cleans the markdown, and refreshes the session list.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LingSuiYA/deepseek-web-import-f.git"
  },
  "homepage": "https://github.com/LingSuiYA/deepseek-web-import-f#readme",
  "bugs": {
    "url": "https://github.com/LingSuiYA/deepseek-web-import-f/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "docs",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "web-ui",
    "import",
    "conversations",
    "session"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:serve": "echo 'run test/compat.mjs and test/live-import.mjs from a DSH install directory (see docs/COMPATIBILITY.md)'"
  }
}
